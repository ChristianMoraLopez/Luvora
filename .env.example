# ─────────────────────────────────────────────────────────────
# LUVORA — Environment variables (copy to .env.local)
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-PUBLISHABLE-ANON-KEY"   # public — RLS protects data
SUPABASE_SERVICE_ROLE_KEY=""                                # server only — for image uploads; never expose

# Mercado Pago (Colombia) — https://www.mercadopago.com.co/developers
# Toggle which credentials the checkout uses: "test" | "prod"
MERCADOPAGO_MODE="test"
MP_ACCESS_TOKEN_TEST="APP_USR-..."   # server only
MP_PUBLIC_KEY_TEST="APP_USR-..."
MP_ACCESS_TOKEN_PROD="APP_USR-..."   # server only
MP_PUBLIC_KEY_PROD="APP_USR-..."

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
