# ─────────────────────────────────────────────────────────────
# LUVORA — Environment variables (copy to .env.local)
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-PUBLISHABLE-ANON-KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"   # server only — never expose

# Mercado Pago (Colombia) — https://www.mercadopago.com.co/developers
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."              # server only
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="APP_USR-..."
MERCADOPAGO_WEBHOOK_SECRET="..."

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
